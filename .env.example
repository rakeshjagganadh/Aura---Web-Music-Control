# APP_URL: The public URL where this applet is hosted.
APP_URL=

# YOUTUBE_API_KEY: Server-only official Google YouTube Data API v3 key for Universal Search proxy (/api/yt/search).
# Never expose this key with a VITE_ prefix in client bundles.
YOUTUBE_API_KEY=
YOUTUBE_DATA_API_KEY=

# LISTEN TOGETHER SECURITY (WebSocket server)
# ROOM_TOKEN_SECRET: Secret key used to sign session & host tokens for /api/room-ws.
# ALLOWED_ORIGINS: Comma-separated allowed WebSocket/CORS origins (e.g. https://aura.example.com).
ROOM_TOKEN_SECRET=
ALLOWED_ORIGINS=

# SUPABASE: Required for Listen Together synchronized rooms across serverless/cloud deployments.
# Found in Supabase Project Settings -> API (Project URL and Anon/Public API Key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AUDIUS: Optional custom app name identifier for Audius decentralized streaming
VITE_AUDIUS_APP_NAME=

# JAMENDO: Optional client ID for Jamendo Creative Commons music catalog (from developer.jamendo.com)
VITE_JAMENDO_CLIENT_ID=
