# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted.
APP_URL=

# YOUTUBE_DATA_API_KEY: Optional official Google YouTube Data API v3 key for Universal Search.
YOUTUBE_DATA_API_KEY=
VITE_YOUTUBE_DATA_API_KEY=

# SUPABASE: Required for Listen Together synchronized rooms across production networks.
# Found in Supabase Project Settings -> API (Project URL and Anon/Public API Key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AUDIUS: Optional custom app name identifier for Audius decentralized streaming
VITE_AUDIUS_APP_NAME=


